{
	"luci-theme-koka": {
		"description": "Koka theme settings saved to the router, the login background and pattern uploads, and the Koka settings page",
		"read": {
			"ubus": {
				"file": [
					"read",
					"stat"
				]
			},
			"file": {
				"/tmp/koka-update.log": [
					"read"
				]
			},
			"uci": [
				"koka"
			]
		},
		"write": {
			"ubus": {
				"uci": [
					"set",
					"commit"
				],
				"file": [
					"remove",
					"exec"
				]
			},
			"uci": [
				"koka"
			],
			"cgi-io": [
				"upload"
			],
			"file": {
				"/etc/koka/login-bg": [
					"write",
					"remove"
				],
				"/etc/koka/pattern.svg": [
					"write",
					"remove"
				],
				"/usr/share/koka/update-theme.sh": [
					"exec"
				],
				"/etc/init.d/koka-update": [
					"exec"
				]
			}
		}
	}
}
